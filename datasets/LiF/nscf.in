    outdir       = './out'
    verbosity    = 'high'
/
&system
    ibrav       = 2
    celldm(1)   = 7.67420569894
    nat         = 2
    ntyp        = 2
    ecutwfc     = 96.0      ! Pseudo Dojo NC-SR-PBE 'high' hint (F-limited: 96 Ry; Li 82)
    ecutrho     = 384.0     ! NC pseudos: 4 x ecutwfc
    occupations = 'fixed'
    nbnd        = 20          ! 5 valence + conduction manifold for Wannier disentanglement
    ! NO nosym/noinv: EPW dimensions arrays by the crystal nsym; nosym=.true. mis-sizes
    ! them -> gmap overflow / "free(): invalid size" in ep_coarse_unfolding (EPW forum
    ! t=1283). The explicit K_POINTS crystal list below is already un-reduced (nscf never
    ! folds an explicit list), so we keep all 216 pts AND the correct 48-op symmetry.
/
&electrons
    conv_thr        = 1.0d-12
    diagonalization = 'david'
/
